# Copy this file to .env and fill in what you use. .env is git-ignored.
# Every value is optional. A variable set in your shell wins over .env.

# --- Where data lives -------------------------------------------------------
# The paper cache (raw downloads, parsed text, chunks, vectors). Default:
# ~/.paper-extractor/cache. Any local folder works, including one that your
# sync tool backs up. Leave these commented out when you use Docker.
# PAPER_CACHE_DIR=~/Google Drive/My Drive/paper-cache
# Run outputs (Excel, CSV, review queue). Default: runs/ next to app.py.
# PAPER_RUNS_DIR=runs

# --- NCBI (PubMed / PMC) ------------------------------------------------------
# NCBI asks for a contact address. With an API key the rate limit rises from
# 3 to 10 requests a second: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_EMAIL=
NCBI_API_KEY=

# --- Extraction model ---------------------------------------------------------
# ollama (local, no key) | anthropic | openai | llama_cpp
LLM_BACKEND=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
# Only for the hosted backends:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings ---------------------------------------------------------------
# sentence_transformers runs locally and needs no key. A different provider,
# model or revision writes to a new cache namespace.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_REVISION=
